{
  "name": "pharmacy-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node src/main.js",
    "start:legacy": "node server.js",
    "build": "node --check src/main.js && node --check src/app.module.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed-admin.js",
    "test": "node --test tests/*.test.js",
    "sync:inventory": "node scripts/sync-local-sqlite-to-postgres.js",
    "sync:inventory:replace": "node scripts/sync-local-sqlite-to-postgres.js --replace"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.1.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  }
}
