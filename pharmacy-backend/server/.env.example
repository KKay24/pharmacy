# Local development defaults
PORT=5001
NODE_ENV=development

# Render/production should use Postgres via DATABASE_URL.
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12
DATABASE_URL=
POSTGRES_URL=

# Keep SQLite for local development only.
SQLITE_STORAGE_PATH=./pharmacy.sqlite

# Keep demo seeding off in production deployments.
ENABLE_DEMO_SEEDING=false
ALLOW_LEGACY_DEV_AUTH=false

# Used only by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Set this to your primary Vercel production URL after the frontend is deployed.
FRONTEND_URL=http://localhost:3000

# Additional allowed origins, comma-separated.
FRONTEND_URLS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Allows https://*.vercel.app preview deployments in production.
ALLOW_VERCEL_PREVIEWS=true
