# Local development defaults
PORT=5001
NODE_ENV=development

# Render/production should use Postgres via DATABASE_URL and a strong JWT_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12
DATABASE_URL=
POSTGRES_URL=

# Keep SQLite for local development and tests only.
SQLITE_STORAGE_PATH=./pharmacy.sqlite

# Keep demo seeding off in production deployments.
ENABLE_DEMO_SEEDING=false
ALLOW_LEGACY_DEV_AUTH=false

# Used only by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Set this to your primary Vercel production URL after the frontend is deployed.
FRONTEND_URL=http://localhost:3000

# Additional allowed origins, comma-separated (e.g. mobile/web local ports and custom production domains).
FRONTEND_URLS=http://localhost:3000,http://localhost:8081,http://localhost:19006,https://www.mediquick.online,https://mediquick.online

# Allows https://*.vercel.app preview deployments in production.
ALLOW_VERCEL_PREVIEWS=true

# Reverse-proxy IP extraction (Render = 1 hop; local dev = 0).
# If frontend traffic also passes through Vercel's /api proxy, configure matching PROXY_SHARED_SECRET on both Vercel and Render.
TRUST_PROXY_HOPS=1
PROXY_SHARED_SECRET=

# Authentication rate limiting, temporary cooldowns, suspicious-activity detection & audit retention
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_RATE_LIMIT_IP_MAX_FAILURES=10
AUTH_RATE_LIMIT_ACCOUNT_MAX_FAILURES=5
AUTH_RATE_LIMIT_ACCOUNT_GLOBAL_MAX_FAILURES=8
AUTH_SHORT_BURST_WINDOW_MS=60000
AUTH_SHORT_BURST_MAX=3
AUTH_MULTI_ACCOUNT_IP_THRESHOLD=3
AUTH_AUDIT_RETENTION_DAYS=90

# Optional IP geolocation for approximate location in admin Security & Login Activity (best-effort, non-blocking)
# Supported IP_GEO_PROVIDER values: ipwho | ipinfo
IP_GEO_ENABLED=true
IP_GEO_PROVIDER=ipwho
IP_GEO_API_KEY=
IP_GEO_BASE_URL=
IP_GEO_TIMEOUT_MS=1500
IP_GEO_CACHE_TTL_MS=86400000

# Optional receipt email delivery through Resend. Keep the API key only on the backend.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=

# Optional pharmacy details used in emailed receipts.
PHARMACY_NAME=MediQuick Pharmacy
PHARMACY_ADDRESS=
PHARMACY_PHONE=

# MediQuick Smart Assistant (Medical AI) — keep API keys strictly on the backend.
# Supported AI_PROVIDER values: gemini | openai | anthropic | openai-compatible
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_MAX=15
AI_RATE_LIMIT_WINDOW_MS=60000
