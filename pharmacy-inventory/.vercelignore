# Files and directories to ignore during Vercel deployment

# Development files
server/config/*.sqlite
*.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation (optional - uncomment if you don't want docs deployed)
# *.md
# docs/

# Docker files (not needed on Vercel)
Dockerfile
docker-compose.yml
.dockerignore
ecosystem.config.js
nginx.conf.example

# Git
.git
.gitignore
